   "lines": {
    "6a": {
     "start": 0.35,
     "end": 3.593,
     "text": "Under the hood, it's small, and strict.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6b": {
     "start": 4.293,
     "end": 10.952,
     "text": "At the center is the runtime. Every tool run produces an immutable result, and a receipt.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6c": {
     "start": 11.452,
     "end": 15.429,
     "text": "Content goes into a store that verifies every hash.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6d": {
     "start": 15.929,
     "end": 20.008,
     "text": "Relationships go into HydraDB, as a lineage graph.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6e": {
     "start": 20.508,
     "end": 26.914,
     "text": "When a correction arrives, HydraDB walks that graph natively, to find everything downstream.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6f": {
     "start": 27.414,
     "end": 34.341,
     "text": "The runtime re-runs stale steps in order, reuses what's current, and records new receipts.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6g": {
     "start": 34.841,
     "end": 40.067,
     "text": "If evidence is missing, it fails closed. No fallback. No guess.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6h": {
     "start": 40.567,
     "end": 45.739,
     "text": "Around it: a browser app, a Python API, and an MCP server.",
     "take": "t1",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    },
    "6i": {
     "start": 46.239,
     "end": 51.297,
     "text": "Agents choose plans from typed tools, but never run arbitrary code.",
     "take": "t2",
     "model": "gemini-3.8-flash-lite-tts",
     "exact": true
    }
   },
